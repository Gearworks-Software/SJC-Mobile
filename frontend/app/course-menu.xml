<Page class="page" xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
    <ActionBar title="Courses" class="action-bar" />

    <!-- <StackLayout class="course-menu"> -->
        <ListView items="{{ courses }}">
            <ListView.itemTemplate>
                <StackLayout class="course-card">
                    <!-- <Image src="{{ imageUrl }}" /> -->
                    <Label text="{{ title }}" class="course-title" />
                    <Label text="{{ description }}" class="course-description" />
                </StackLayout>
            </ListView.itemTemplate>
        </ListView>
    <!-- </StackLayout> -->
</Page>