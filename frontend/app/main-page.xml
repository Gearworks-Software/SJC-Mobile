<Page class="page" xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
    <ActionBar title="SJC-JC Login" class="action-bar" />
    
    <StackLayout class="form-container" verticalAlignment="center" horizontalAlignment="center">
        <Image src="~/images/sjc-logo.png" class="logo" />
        
        <TextField hint="Email" keyboardType="email" class="input" />
        <TextField hint="Password" secure="true" class="input" />
        
        <Button text="Login" class="btn btn-primary" tap="onLoginTap" />
    </StackLayout>
</Page>
