<Page class="page" xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo">
    <ActionBar title="Event Calendar" class="action-bar" />
    
    <GridLayout>
        <StackLayout>
            <Label text="Event Calendar" class="h2" horizontalAlignment="center"/>
            
            <ListView id="calendar" items="{{ events }}" class="event-list">
                <ListView.itemTemplate>
                    <StackLayout>
                        <Label text="{{ date }}" class="event-date"/>
                        <Label text="{{ event }}" class="event-description"/>
                    </StackLayout>
                </ListView.itemTemplate>
            </ListView>
        </StackLayout>
    </GridLayout>
</Page>

