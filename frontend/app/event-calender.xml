<GridLayout>
    <StackLayout>
        <Label text="Event Calendar" class="h2" horizontalAlignment="center"/>
        
        <ListView id="calendar" items="{{ events }}" class="event-list">
            <ng-template let-item="item">
                <StackLayout>
                    <Label text="{{ item.date }}" class="event-date"/>
                    <Label text="{{ item.event }}" class="event-description"/>
                </StackLayout>
            </ng-template>
        </ListView>
    </StackLayout>
</GridLayout>

